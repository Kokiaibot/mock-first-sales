{
  "name": "mock-first-sales",
  "version": "0.1.0",
  "private": true,
  "description": "AIモック先出し型・法人営業支援システム（ローカルWebアプリ）",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "seed:demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed-demo.ts",
    "backup": "node --disable-warning=ExperimentalWarning --import tsx scripts/backup.ts",
    "restore": "node --disable-warning=ExperimentalWarning --import tsx scripts/restore.ts",
    "doctor": "node --disable-warning=ExperimentalWarning --import tsx scripts/doctor.ts",
    "docs": "node --disable-warning=ExperimentalWarning --import tsx scripts/gen-docs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node --disable-warning=ExperimentalWarning --import tsx scripts/e2e.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.65.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
