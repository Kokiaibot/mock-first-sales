# 設定サンプル（PowerShell では $env:PORT="8787" のように設定。秘密情報はここに書かない）
# 待受アドレス。既定はローカルのみ。ローカル以外にする場合は ALLOW_REMOTE=1 が必須（非推奨）
HOST=127.0.0.1
PORT=8787
# データ保存先（既定: <アプリフォルダ>\data）
# DATA_DIR=C:\Users\you\mock-sales-data
# 外部閲覧可能なプレビューの公開URL（公開デプロイ後のみ。承認前は設定しない）
# PUBLIC_BASE_URL=https://preview.example.com
# 並列処理数（1〜4）
WORKER_CONCURRENCY=2
# スクリーンショットに使うブラウザを明示する場合
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# ブラウザを使わない（表示系の分析は「未確認」になる）
# MFS_NO_BROWSER=1
